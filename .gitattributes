# Windows CRLF endings expected on server
* text eol=crlf

# Explicitly set Unix LF endings for .sh files
*.sh text eol=lf

# GitHub Actions workflows must be LF (Dependabot fails on CRLF): https://github.com/dependabot/dependabot-core/issues/16326
.github/workflows/*.yml text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.keys binary
wallet binary