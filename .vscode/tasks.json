{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-plugin",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Plugins/Monero/BTCPayServer.Plugins.Monero.csproj",
                "/p:GenerateFullPaths=true",
                "--output",
                "${env:HOME}/.btcpayserver/Plugins/BTCPayServer.Plugins.Monero/"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-btcpay",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/submodules/btcpayserver/BTCPayServer/BTCPayServer.csproj",
                "/p:GenerateFullPaths=true"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "dependsOn": ["build-plugin", "build-btcpay"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
